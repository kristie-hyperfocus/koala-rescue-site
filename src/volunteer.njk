  <!-- Training & Support -->
  <section class="section section--light">
    <div class="container">
      <div class="community-layout" style="margin-top: 0;">
        <div class="community-image">
          <img src="website-images/Training session March 2025.jpg" alt="KRBS volunteers at a training session with the Koala Rescue Brisbane South banner" loading="lazy">
        </div>
        <div class="community-text">
          <h2>Training &amp; support</h2>
          <p>Every volunteer receives the necessary training, which includes rescue protocols, animal handling, safety procedures, communication and wildlife science. We meet regularly for hands-on training and team development.</p>
          <p style="margin-top: 1rem;">John Knights mentors new volunteers. You'll learn from someone who has been rescuing koalas for over 15 years, and you'll be equipped with the skills and confidence to respond safely and appropriately in any situation.</p>
          <div class="alert-box" style="margin-top: 1.5rem;">
            <span class="material-symbols-outlined" style="color: var(--dark-green); vertical-align: middle; font-size: 20px; margin-right: 0.4rem;">schedule</span>
            <strong>Flexible commitment.</strong> We know life is busy. We work around your schedule and ask only that you show up when you say you will.
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Expression of Interest Form -->
  <section class="section" id="volunteer-form">
    <div class="container">
      <div class="vol-form-wrap">
        <h2 style="text-align: center; margin-bottom: 0.5rem;">Express your interest</h2>
        <p style="text-align: center; color: var(--text-light); margin-bottom: 0.25rem;">Please complete the form below.</p>
        <p style="text-align: center; color: var(--text-light); margin-bottom: 2rem;">We'll be in touch to chat about how you can get involved.</p>
        <form class="vol-form" name="volunteer-interest" method="POST" action="/thank-you" data-netlify="true" netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="volunteer-interest">
          <p style="display:none;"><label>Don't fill this out: <input name="bot-field"></label></p>
          <div class="vol-form-row">
            <div class="vol-form-field">
              <label for="vol-name">Full name</label>
              <input type="text" id="vol-name" name="full-name" required placeholder="Your full name">
            </div>
            <div class="vol-form-field">
              <label for="vol-phone">Phone number</label>
              <input type="tel" id="vol-phone" name="phone" required placeholder="0400 000 000">
            </div>
          </div>
          <div class="vol-form-field">
            <label for="vol-email">Email address</label>
            <input type="email" id="vol-email" name="email" required placeholder="you@email.com">
          </div>
          <div class="vol-form-field">
            <label>Which role(s) interest you at this stage? <span style="font-weight:400; color:var(--text-light);">(You may choose more than one)</span></label>
            <div class="vol-form-checkboxes">
              <label class="vol-checkbox"><input type="checkbox" name="roles" value="Phone Coordinator"> Phone coordinator</label>
              <label class="vol-checkbox"><input type="checkbox" name="roles" value="First Responder"> First responder</label>
              <label class="vol-checkbox"><input type="checkbox" name="roles" value="Rescuer"> Rescuer</label>
              <label class="vol-checkbox"><input type="checkbox" name="roles" value="Rescue Support"> Rescue support</label>
              <label class="vol-checkbox"><input type="checkbox" name="roles" value="Trap/Tree Sitter"> Trap / tree sitter</label>
              <label class="vol-checkbox"><input type="checkbox" name="roles" value="Transporter"> Transporter</label>
              <label class="vol-checkbox"><input type="checkbox" name="roles" value="Administration"> Administration</label>
              <label class="vol-checkbox"><input type="checkbox" name="roles" value="Community Advocate"> Community advocate</label>
              <label class="vol-checkbox"><input type="checkbox" name="roles" value="Not sure yet"> Not sure yet</label>
            </div>
          </div>
          <div class="vol-form-field">
            <label for="vol-suburb">What's your suburb and how would you like to help?</label>
            <input type="text" id="vol-suburb" name="suburb-and-help" placeholder="e.g. Coorparoo — happy to help with phone coordination">
          </div>
          <div class="vol-form-field">
            <label for="vol-message">Tell us a bit about yourself</label>
            <textarea id="vol-message" name="message" required placeholder="Where do you live, why you want to help, any relevant experience..." rows="4"></textarea>
          </div>
          <button type="submit" class="btn" style="width: 100%; justify-content: center;">Submit expression of interest</button>
        </form>
      </div>
    </div>
  </section>
